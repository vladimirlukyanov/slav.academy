---
import {MobileMenu} from '~/components/header/index.ts'
---

<div id="main_mobile_menu" class="menu main">
    <div class="overlay show blurred">
        <div class="section">
            <MobileMenu />
        </div>
    </div>
</div>

<style lang="scss">
  @use "sass:list";
  @use "sass:meta";
  @use "sass:string";

  @use '~/styles/app.scss' as app;

  // ↓ Overlay
  @use '@nulllogic/scssleon/scss/components/overlay' with (
      $config: app.$config,
      $theme: app.$theme
  );

  $menu: (
    position: fixed,
    top: 0,
    left: 0,
    bottom: 0,
    width: 100%,
    height: auto,
    z-index : app.get-config(app.$config, 'z-index.header'),
    display: none,
    transition: string.unquote('display .32s ease-in allow-discrete'),
    _subclasses : (
      '&.main' : (
        top: 47px,
        _subclasses : (
          '.overlay' : (
            --align-items : start,
            --justify-content: start,
            transition: string.unquote("opacity .32s cubic-bezier(.4,0,.6,1) 80ms, visibility .32s"),
            opacity: 0,
            _subclasses : (
              '.section' : (
                padding-inline: var(--padding-inline),
                padding-block: 20px,
                border: none,
                border-radius: 0,
                width: 100%,
                height: 0,
                overflow-y: scroll,
                transition : string.unquote("height 373.5ms cubic-bezier(.4,0,.6,1) 80ms, background 373.5ms cubic-bezier(.4,0,.6,1) 80ms"),
                background: oklch(0.25 0.02 161.44 / 0.16),
                _responsive : (
                  sm : (
                    max-width: 410px,
                  )
                )
              )
            )
          )
        )
      ),
      '&.show' : (
        display: block,
        transition: string.unquote('display .32s ease-out allow-discrete'),
        _subclasses : (
          '.overlay' : (
            opacity: 1,
            transition: string.unquote("opacity .32s cubic-bezier(.4,0,.6,1) 80ms, visibility .32s step-start 80ms"),
            _atrule : (
              '@starting-style' : (
                opacity: 0,
              )
            ),
            _subclasses : (
              '.section' : (
                height: 100dvh,
                _atrule : (
                  '@starting-style' : (
                    height: 0,
                  )
                ),
              )
            )
          )
        ),
        _responsive : (
          lg : (
            display: none,
          )
        )
      ),
    )
  );

  @include app.generate-component($menu, 'menu', app.$config, app.$theme);
</style>