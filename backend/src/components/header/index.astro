<div class="header top">
    <div class="container xxl">
        <nav class="navbar">
            <div class="left">
                <ul class="nav">
                    <li class="item">

                    </li>
                    <li class="item">

                    </li>
                </ul>
            </div>
            <div class="center">
                <a href="/" class="link" title="NullLab homepage">
                    <span class="logo-wrapper">
                        <Logo/>
                        <span class="slogan">Development & Research</span>
                    </span>
                </a>
            </div>
            <div class="right">
                <ul class="nav">
                    <li class="item">

                    </li>
                    <li class="item">

                    </li>
                </ul>
            </div>
        </nav>
    </div>
</div>

<nav class="navigation header bottom" role="navigation" itemscope
     itemtype="http://schema.org/SiteNavigationElement">
    <div class="container xxl">
        <div class="navbar">
            <div class="left">
                <div class="relative">
                    <a href="/" class="link" title="NullLab homepage">
                        <Logo class="logo"/>
                    </a>
                </div>
            </div>
            <div class="center">
                <ul class="nav">
                  {categories.length > 0 &&
                    categories.map((category) => {
                      return (
                              <li class="item">
                                  <a href={`/${category.id}/`}
                                     class="link">
                                    {category.data.title}
                                  </a>
                              </li>
                      );
                    })
                  }
                </ul>
            </div>
            <div class="right">
                <div class="relative">
                    <div class="group">
                        <a href="#" class="link main_menu toggle">
                            <svg viewBox="0 0 35 35" class="icon close"
                                 width="24px" fill="none"
                                 stroke="currentColor" stroke-width="2.5">
                                <line x1="1.5" y1="7.5" x2="33.5" y2="7.5"/>
                                <line x1="1.5" y1="17.5" x2="33.5" y2="17.5"/>
                                <line x1="1.5" y1="27.5" x2="33.5" y2="27.5"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</nav>

<style lang="scss">

  @use "sass:list";
  @use "sass:string";
  @use "sass:meta";
  @use "sass:map";

  @use "~/styles/app.scss" as app;

  $hamburger-icon: (
    _subclasses: (
      '&.toggled' : (
        _subclasses : (
          'line' : (
            _subclasses : (
              '&:first-of-type, &:last-of-type' : (
                transform-origin: 7px 23px,
                translate: 0 -1.5px,
                rotate: -45deg,
              ),
              '&:first-of-type' : (
                transform-origin: 4px 13px,
                rotate: 45deg,
              ),
              '&:nth-of-type(2)' : (
                scale: 0% 100%,
                opacity: 0
              ),
            )
          )
        )
      ),
      'line' : (
        transition: none 300ms ease,
        transition-property: string.unquote("transform-origin, translate, rotate, scale, opacity"),
        _subclasses: (
          '&:first-of-type' : (
            transform-origin: 2px 8px
          ),
          '&:last-of-type' : (
            transform-origin: 2px 26px
          ),
          '&:nth-of-type(2)' : (
            transform-origin: center,
            animation-duration: 150ms,
          )
        )
      )
    )
  );

  $header-top: (
    opacity: 1,
    display: inherit,
    //
    border-bottom: var(--border-bottom),
    background: var(--background),
    //
    z-index : app.get-config(app.$config, 'z-index.header'),
    _colors : (
      dark : (
        background: linear-gradient(rgba(0, 0, 0, 0) 0px, oklch(0.52 0.08 187.39 / 0.2) 125%),
      )
    ),
    _subclasses: (
      '.navbar' : (
        padding: 0 0 10px 0,
        margin: 0 0 5px 0,
        --grid-template-columns: 1fr auto 1fr,
      ),
      '.logo-wrapper' : (
        display: flex,
        flex-direction: column,
        align-items: center,
        /***/
        _subclasses: (
          /***/
          '.slogan' : (
            opacity: 1,
            display: inherit,
            font-family: string.unquote('monospace, sans-serif'),
            font-size: 0.825rem,
          )
        )
      )
    ),
  );

  $header-bottom: (
    padding-inline: var(--padding-inline),
    border-bottom: var(--border-bottom),
    background: var(--background),
    transition: string.unquote("background .32s ease-in-out"),
    /***/
    _responsive : (
      xxl : (
        padding-block: 0,
      )
    ),
    /***/
    _subclasses: (
      '.navbar' : (
        --grid-template-columns: 1fr auto 1fr,
        padding: 15px 0,
        min-height: 46px,
        /***/
        _subclasses: (
          '.right' : (
            display: none,
            text-align: right,
          ),
          '.logo' : (
            display: none,
          ),
          '.nav' : (
            /***/
            _subclasses: (
              '.item' : (
                _subclasses: (
                  '.link' : (
                    padding: 0 5px,
                    /***/
                    _subclasses: (
                      '&:hover' : (
                        text-decoration: underline,
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  );

  $header-bottom-modify: (
    _subclasses : (
      '&.solid' : (
        _colors: (
          dark: (
            sticky-background: oklch(0.24 0.04 164.03),
          ),
        ),
      ),
      '.navbar' : (
        --grid-template-columns: auto 1fr,
        _subclasses : (
          '.left' : (
            display: inherit,
            min-width: 96px,
            _subclasses: (
              '.relative' : (
                position: relative,
                _subclasses: (
                  '.logo' : (
                    position: absolute,
                    left: 0,
                    top: -18px,
                    height: 40px,
                    padding-block: 10px,
                  )
                )
              )
            )
          ),
          '.center' : (
            display: none,
            _responsive : (
              xl : (
                display: inherit,
              )
            )
          ),
          '.right' : (
            display: inherit,
            _subclasses: (
              '.relative' : (
                position: relative,
                _subclasses: (
                  '.group' : (
                    position: absolute,
                    right: 0,
                    top: -21px,
                    gap: 10px,
                    display: flex,
                    flex-wrap: wrap,
                    _subclasses: (
                      '.link' : (
                        padding: 10px 5px,
                      )
                    )
                  ),
                  '.icon.close' : $hamburger-icon
                )
              )
            ),
            _responsive : (
              lg : (
                display: none,
              )
            )
          ),
          '.logo' : (
            width: 92px,
            height: auto,
            display: block,
            transition: string.unquote('opacity 0.25s ease-out, display 0.25s ease-out allow-discrete'),
            margin-top: -2px,
            /***/
            _atrule : (
              '@starting-style' : (
                opacity: 1,
              )
            ),
          )
        )
      ),
    )
  );

  $header-sticky: (
    position: sticky,
    -webkit-backdrop-filter: blur(10px),
    backdrop-filter: blur(15px) saturate(3),
    box-shadow: string.unquote("rgba(13, 13, 17, 0.4) 0px 5px 25px"),
    background: var(--sticky-background),
    _subclasses : (
      '.navbar' : (
        padding: 15px 0,
      )
    )
  );

  $header-section: (
    top: 0,
    position: relative,
    z-index: app.get-config(app.$config, 'z-index.header'),
    /***/
    _colors: (
      dark: (
        sticky-background: oklch(27% .04 161 / .75),
        background: oklch(0.52 0.08 187.39 / 0.2),
        border-bottom: 1px solid oklch(0.37 0.03 210.45 / 0.5),
      ),
    ),
    /***/
    _subclasses: (
      '&.top' : $header-top,
      '&.bottom' : $header-bottom,
      '&.sticky': $header-sticky,
      '&.bottom.modify': $header-bottom-modify,
    ),
  );

  @include app.generate-component(
    $header-section,
    'header',
    app.$config,
    app.$theme
  );
</style>

<script>
  const nav_top = document.querySelector('.header.top');
  const nav_bottom = document.querySelector('.header.bottom');

  const stickyNavigation = () => {
    if (window.scrollY > nav_top.offsetHeight) {
      // nav offsetHeight = height of nav
      nav_top.classList.add('modify');
      nav_bottom.classList.add('sticky', 'modify');
    } else {
      nav_top.classList.remove('modify');
      nav_bottom.classList.remove('sticky', 'modify');
    }
  };

  window.addEventListener('scroll', stickyNavigation);
  document.addEventListener('DOMContentLoaded', stickyNavigation);
</script>

<script>

  const light_dark_toggler = document.querySelector('.toggle.dark_mode');

  if (light_dark_toggler) {
    light_dark_toggler.addEventListener('click', (e) => {
      e.preventDefault();

      light_dark_toggler.classList.add('clicked');

      const current_theme = document.documentElement.getAttribute('data-theme');
      const new_theme = current_theme === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', new_theme);

      document.body.classList.add('preload');
      localStorage.setItem('theme', new_theme);
      setTimeout(() => {
        document.body.classList.remove('preload');
      }, 200);
      const event = new CustomEvent('theme_change', {
        detail: {
          theme: new_theme,
        },
      });
      document.dispatchEvent(event);
    });
  }

  const nav = document.querySelector('.header.bottom');
  const buttons = nav.querySelectorAll('.link.toggle');

  buttons.forEach(button => button.addEventListener('click', (e) => {
    e.preventDefault();

    if (button.classList.contains('main_menu')) {
      const menu = document.getElementById('main_mobile_menu');
      menu.classList.toggle('show');
      menu?.querySelector('.nav').classList.toggle('show');
      document.body.toggleAttribute('scroll-lock');
      button.querySelector('svg').classList.toggle('toggled');
      nav.classList.toggle('solid');
    }
  }));

  // BFCache
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) {
      // Force a reload if the user has logged out.
      location.reload();
    }
  });

</script>